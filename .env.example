# =============================================================================
# JurisMind — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development           # development | staging | production
APP_NAME="Indian Law RAG Chatbot"
APP_VERSION=1.0.0
APP_URL=http://localhost:8000
DEBUG=false
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# LLM Provider  (choose one and set the corresponding key)
# -----------------------------------------------------------------------------
LLM_PROVIDER=groq             # groq | gemini | openai | openrouter

# Groq (default — free tier available)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant

# Google Gemini
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxx

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# OpenRouter
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# -----------------------------------------------------------------------------
# Embeddings  (huggingface = free, no API key needed)
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/indian_law_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=indian_law_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password

# -----------------------------------------------------------------------------
# Redis  (for rate limiting & session cache)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your_secure_redis_password

# -----------------------------------------------------------------------------
# JWT Authentication  (generate with: openssl rand -hex 32)
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=your_jwt_secret_key_change_this_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Google OAuth 2.0  (https://console.cloud.google.com/)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# -----------------------------------------------------------------------------
# Encryption & Signing  (generate with: openssl rand -hex 32)
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=your_32_byte_encryption_key_here
API_SIGNING_KEY=your_api_signing_key_here

# -----------------------------------------------------------------------------
# CORS  (comma-separated origins; leave empty to use environment defaults)
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# -----------------------------------------------------------------------------
# Security Settings
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20
ENABLE_HSTS=false           # Set true in production (HTTPS only)
ENABLE_CSP=true
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Email — Brevo (Sendinblue) Transactional Email
# https://www.brevo.com/
# -----------------------------------------------------------------------------
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
SUPPORT_EMAIL=support@jurismind.app
SUPPORT_EMAIL_NAME=JurisMind Support
PASSWORD_RESET_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# RAG Configuration
# -----------------------------------------------------------------------------
FAISS_INDEX_PATH=./data/faiss_index
TOP_K_RESULTS=5
CHUNK_SIZE=1500
CHUNK_OVERLAP=300
